@implements IDisposable
@inject OnlineSession Session
@inject JavascriptBridge Js
@inject DataStore Store
@inject IJSRuntime JS

@switch (Session.State)
{
    case OnlineSessionState.Starting:
    case OnlineSessionState.Loading:
        <div class="splash-loading" role="status" aria-live="polite">
            <div class="splash-rings">
                <div class="splash-ring splash-ring-outer"></div>
                <div class="splash-ring splash-ring-inner"></div>
                <div class="splash-brand">@L.InitialesApplication()</div>
            </div>
            @if (Session.State == OnlineSessionState.Loading)
            {
                <p class="online-splash-text">@L.T("Chargement des données de la communauté…")</p>
            }
        </div>
        break;
    case OnlineSessionState.SignedOut:
        <AuthPage />
        break;
    case OnlineSessionState.Ready:
        <App />
        break;
    default:
        <AccountStatusPage />
        break;
}

<Toaster />

@code {
    /// <summary>Nom de la communauté gardé sur l'appareil (écran de connexion), avant le chargement des données.</summary>
    public static string? NomGarde { get; set; }

    private sealed record MarqueGardee(string? Nom);

    private static readonly string NomParDefaut = new AppSettings().AppName;

    protected override async Task OnInitializedAsync()
    {
        // Les textes qui parlent de « la communauté » citent le nom de l'application.
        try { NomGarde ??= ((IJSInProcessRuntime)JS).Invoke<MarqueGardee>("guMarque.lire")?.Nom; } catch { }
        L.NomApplication = () =>
        {
            var nom = Store.Settings.AppName?.Trim();
            if (string.IsNullOrEmpty(nom) || nom == NomParDefaut) nom = NomGarde?.Trim();
            return string.IsNullOrEmpty(nom) || nom == NomParDefaut ? null : nom;
        };
        Session.Changed += OnChanged;
        await Session.InitializeAsync();
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // L'écran de démarrage de index.html s'efface dès que la session est connue
        // (connexion, compte en attente…), sans attendre l'application complète.
        if (Session.State != OnlineSessionState.Starting)
        {
            try { await Js.NotifySplashReadyAsync(); } catch { }
        }
    }

    public void Dispose() => Session.Changed -= OnChanged;
}
