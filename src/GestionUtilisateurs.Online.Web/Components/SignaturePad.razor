@inject JavascriptBridge Js
@implements IAsyncDisposable

<div class="sig-pad">
    <canvas id="@_canvasId" class="sig-canvas"></canvas>
    <p class="sig-hint">Dessinez avec le doigt, le stylet ou la souris.</p>
    @if (!string.IsNullOrEmpty(_error))
    {
        <p class="form-error">@_error</p>
    }
    <div class="sig-actions">
        <button type="button" class="btn btn-secondary btn-sm" @onclick="ClearAsync">🧹 Effacer</button>
    </div>
</div>

@code {
    private readonly string _canvasId = "sig-" + Guid.NewGuid().ToString("N");
    private string? _error;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Task.Delay(50);
            await Js.SignatureInitAsync(_canvasId);
        }
    }

    public async Task ClearAsync()
    {
        _error = null;
        await Js.SignatureClearAsync(_canvasId);
        StateHasChanged();
    }

    /// <summary>Retourne le PNG (data URL fond blanc) ou null si le pad est vide.</summary>
    public async Task<string?> GetDataUrlAsync()
    {
        if (await Js.SignatureIsEmptyAsync(_canvasId))
        {
            _error = "Veuillez dessiner votre signature avant de valider.";
            StateHasChanged();
            return null;
        }
        _error = null;
        return await Js.SignatureGetDataUrlAsync(_canvasId);
    }

    public Task<bool> IsEmptyAsync() => Js.SignatureIsEmptyAsync(_canvasId);

    public async ValueTask DisposeAsync()
    {
        try { await Js.SignatureDestroyAsync(_canvasId); } catch { }
    }
}
