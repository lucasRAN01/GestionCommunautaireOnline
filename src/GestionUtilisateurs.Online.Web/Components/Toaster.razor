@implements IDisposable
@inject AppState State

<div class="notifications-container">
    @foreach (var t in _toasts)
    {
        <div class="notification @t.Type">
            <span>@t.Message</span>
            <button type="button" class="notification-close" aria-label="Fermer" @onclick="() => Dismiss(t.Id)">&times;</button>
        </div>
    }
</div>

@code {
    private sealed record ToastItem(Guid Id, string Message, string Type);

    private readonly List<ToastItem> _toasts = new();

    protected override void OnInitialized()
    {
        State.Toast += OnToast;
    }

    private void OnToast(string message, string type) => InvokeAsync(() =>
    {
        var item = new ToastItem(Guid.NewGuid(), message, type);
        _toasts.Add(item);
        StateHasChanged();

        var t = new System.Threading.CancellationTokenSource(3500);
        _ = Task.Delay(3500, t.Token).ContinueWith(_ => InvokeAsync(() => Dismiss(item.Id)));
    });

    private void Dismiss(Guid id)
    {
        _toasts.RemoveAll(t => t.Id == id);
        StateHasChanged();
    }

    public void Dispose()
    {
        State.Toast -= OnToast;
    }
}