    private string PurgeMessage => _purgeTargets.Count switch
    {
        0 => "",
        1 => "Supprimer définitivement « " + _purgeTargets[0].Titre + " » ? Action irréversible.",
        var n => "Supprimer définitivement " + n + " documents ? Action irréversible."
    };

    private void AskPurge(DocumentItem doc)
    {
        _purgeTargets = new List<DocumentItem> { doc };
        _confirmPurge = true;
    }

    private void AskPurgeSelected()
    {
        _purgeTargets = _trash.Where(d => _selected.Contains(d.Id)).ToList();
        if (_purgeTargets.Count > 0) _confirmPurge = true;
    }

    private void CancelPurge()
    {
        _confirmPurge = false;
        _purgeTargets.Clear();
    }

    private void DoPurge()
    {
        _confirmPurge = false;
        var targets = _purgeTargets;
        _purgeTargets = new List<DocumentItem>();
        if (targets.Count == 0) return;
        string? error = null;
        var done = 0;
        foreach (var doc in targets)
        {
            var res = Store.PurgeDocument(doc.Id);
            if (res.Success) done++;
            else error ??= res.Error;
        }
        _selected.Clear();
        _selectionMode = false;
        if (error != null) State.NotifyError(error);
        else State.NotifySuccess(done == 1 ? "Document définitivement supprimé." : done + " documents définitivement supprimés.");
    }

