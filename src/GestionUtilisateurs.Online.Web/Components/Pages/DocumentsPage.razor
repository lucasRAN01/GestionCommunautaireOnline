@implements IDisposable
@inject DataStore Store
@inject AppState State
@inject DocumentService Docs
@inject NativeFileSaver Saver

@*
    Gestion documentaire — trois mises en page distinctes (voir site.css / app.css, section « Documents ») :
    - Téléphone (< 720 px)   : liste de cartes, onglets Documents/Corbeille, fil d'Ariane compact, bouton + flottant,
                               barre de sélection fixée en bas.
    - Tablette (≥ 720 px)    : volet latéral (bibliothèque + arborescence des dossiers + stockage) et documents en tuiles.
    - Web / bureau           : volet latéral élargi et documents en tableau (colonnes triables Nom / Taille / Modifié).
    Le balisage est unique ; seule la feuille de style change la présentation.
*@

@if (!string.IsNullOrEmpty(_error))
{
    <EmptyState Icon="⚠" Title="Impossible d'afficher les documents" Message="@_error">
        <button class="btn btn-primary" @onclick="RetryLoad">Réessayer</button>
    </EmptyState>
}
else
{
    <div class="docs-page @(_selectionMode ? "is-selecting" : "") @(_view == "corbeille" ? "is-trash" : "")">
        @if (_quotaAlmostFull)
        {
            <div class="quota-banner">
                <span class="quota-banner-icon" aria-hidden="true">⚠</span>
                <div class="quota-banner-main">
                    <strong>Stockage presque plein (@_quotaPercent.ToString("0") %)</strong>
                    <span>@FormatSize(_usedBytes) utilisés. Pensez à vider la corbeille.</span>
                </div>
                @if (_trashCount > 0)
                {
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="AskEmptyTrash">Vider la corbeille</button>
                }
            </div>
        }

        <div class="docs-layout">
            <aside class="docs-side" aria-label="Bibliothèque et dossiers">
                <button type="button" class="btn btn-primary btn-block docs-side-add" @onclick="() => _fabOpen = true">+ Ajouter</button>

                <nav class="docs-side-nav" aria-label="Bibliothèque">
                    <button type="button" class="docs-side-item @(_view == "docs" && !_query.FavoritesOnly ? "active" : "")" @onclick="ShowAllDocuments">
                        <span class="docs-side-icon" aria-hidden="true">📄</span>
                        <span class="docs-side-label">Documents</span>
                        <span class="docs-side-count">@_docCount</span>
                    </button>
                    <button type="button" class="docs-side-item @(_view == "docs" && _query.FavoritesOnly ? "active" : "")" @onclick="ShowFavorites">
                        <span class="docs-side-icon docs-star" aria-hidden="true">★</span>
                        <span class="docs-side-label">Favoris</span>
                        <span class="docs-side-count">@_favCount</span>
                    </button>
                    <button type="button" class="docs-side-item @(_view == "corbeille" ? "active" : "")" @onclick='() => SetView("corbeille")'>
                        <span class="docs-side-icon" aria-hidden="true">🗑</span>
                        <span class="docs-side-label">Corbeille</span>
                        <span class="docs-side-count">@_trashCount</span>
                    </button>
                </nav>

                <div class="docs-side-title">
                    <span>Dossiers</span>
                    <button type="button" class="btn-icon" aria-label="Nouveau dossier" title="Nouveau dossier" @onclick="StartNewFolder">+</button>
                </div>
                <div class="docs-tree">
                    <button type="button" class="docs-tree-item @(IsTreeActive(null) ? "active" : "")" style="--depth:0"
                            aria-current="@(IsTreeActive(null) ? "page" : null)" @onclick="() => OpenFolder(null)">
                        <span class="docs-tree-icon" aria-hidden="true">🏠</span>
                        <span class="docs-side-label">Racine</span>
                    </button>
                    @foreach (var (folder, depth) in _tree)
                    {
                        var f = folder;
                        <button type="button" class="docs-tree-item @(IsTreeActive(f.Id) ? "active" : "")" style="--depth:@(depth + 1)"
                                aria-current="@(IsTreeActive(f.Id) ? "page" : null)" @onclick="() => OpenFolder(f.Id)">
                            <span class="docs-tree-dot" style="background:@f.Couleur" aria-hidden="true"></span>
                            <span class="docs-side-label">@f.Nom</span>
                            <span class="docs-side-count">@_itemCounts.GetValueOrDefault(f.Id)</span>
                        </button>
                    }
                </div>

            </aside>

            <section class="docs-main">
                <div class="docs-toolbar">
                    <div class="search-box docs-search">
                        <span class="search-icon" aria-hidden="true">&#128269;</span>
                        <input type="search" placeholder="@(_view == "corbeille" ? "Rechercher dans la corbeille…" : "Rechercher un document…")" aria-label="Rechercher" value="@_query.Search"
                               @oninput="e => OnSearch(e.Value?.ToString() ?? string.Empty)" />
                        @if (_query.IsSearching)
                        {
                            <button type="button" class="docs-search-clear" aria-label="Effacer la recherche" @onclick='() => OnSearch("")'>×</button>
                        }
                        @if (_view == "docs")
                        {
                            <button type="button" class="docs-filter-btn @(_query.HasActiveFilters ? "active" : "")" aria-label="Filtres" title="Filtres" @onclick="() => _filtersOpen = true">
                                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M3 5h18l-7 8.5V19l-4 2v-7.5z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" /></svg>
                                @if (_query.HasActiveFilters)
                                {
                                    <span class="docs-filter-count">@_query.ActiveFilterCount</span>
                                }
                            </button>
                        }
                    </div>
                    <div class="docs-toolbar-actions">
                        @if (_view == "docs")
                        {
                            <label class="docs-sort" title="Trier">
                                <span aria-hidden="true">⇅</span>
                                <select aria-label="Trier les documents" value="@_query.Sort" @onchange="OnSort">
                                    @foreach (var (key, label) in DocumentBrowser.SortChoices)
                                    {
                                        <option value="@key">@label</option>
                                    }
                                </select>
                            </label>
                        }
                        <button type="button" class="btn btn-secondary btn-sm docs-select-btn @(_selectionMode ? "active" : "")"
                                aria-pressed="@_selectionMode" @onclick="ToggleSelectMode" disabled="@(!_selectionMode && CurrentList.Count == 0)">
                            @(_selectionMode ? "✕ Annuler" : "☑ Sélectionner")
                        </button>
                    </div>
                </div>

                <div class="cal-view-tabs docs-tabs">
                    <button class="cal-tab @(_view == "docs" ? "active" : "")" @onclick='() => SetView("docs")'>Documents</button>
                    <button class="cal-tab @(_view == "corbeille" ? "active" : "")" @onclick='() => SetView("corbeille")'>Corbeille (@_trashCount)</button>
                </div>

                @if (_view == "docs")
                {
                    <div class="chips-row docs-chips" role="group" aria-label="Filtres rapides">
                        <button type="button" class="chip @(_query.Kind == DocumentBrowser.KindAll && !_query.FavoritesOnly ? "active" : "")" @onclick="ClearQuickFilters">Tous</button>
                        <button type="button" class="chip @(_query.FavoritesOnly ? "active" : "")" aria-pressed="@_query.FavoritesOnly" @onclick="ToggleFavOnly">★ Favoris</button>
                        @foreach (var (key, label) in DocumentBrowser.KindChoices.Skip(1))
                        {
                            var k = key;
                            <button type="button" class="chip @(_query.Kind == k ? "active" : "")" aria-pressed="@(_query.Kind == k)" @onclick="() => SetKind(_query.Kind == k ? DocumentBrowser.KindAll : k)">@label</button>
                        }
                    </div>

                    @if (_query.Categories.Count > 0 || _query.UserId != null)
                    {
                        <div class="docs-active-filters" aria-label="Filtres actifs">
                            @foreach (var c in _query.Categories)
                            {
                                var cat = c;
                                <button type="button" class="docs-filter-tag" aria-label="Retirer le filtre @DocumentCategories.Label(cat)" @onclick="() => ToggleCat(cat)">
                                    @DocumentCategories.Icon(cat) @DocumentCategories.Label(cat) <span aria-hidden="true">×</span>
                                </button>
                            }
                            @if (_query.UserId != null)
                            {
                                <button type="button" class="docs-filter-tag" aria-label="Retirer le filtre utilisateur" @onclick="() => SetUser(null)">
                                    👤 @UserName(_query.UserId) <span aria-hidden="true">×</span>
                                </button>
                            }
                            <button type="button" class="docs-link-btn" @onclick="ResetFilters">Tout effacer</button>
                        </div>
                    }

                    <nav class="doc-crumbs" aria-label="Fil d'Ariane">
                        @if (_query.IsGlobalScope)
                        {
                            <span class="doc-crumb-info">
                                @(_query.IsSearching ? "🔍 Résultats dans tous les dossiers" : "★ Favoris de tous les dossiers")
                            </span>
                        }
                        else
                        {
                            @if (_currentFolderId != null)
                            {
                                <button type="button" class="doc-crumb-back" aria-label="Dossier parent" @onclick="GoUp">‹</button>
                            }
                            <button type="button" class="doc-crumb doc-crumb-root @(_currentFolderId == null ? "active" : "")"
                                    aria-current="@(_currentFolderId == null ? "page" : null)" @onclick="() => OpenFolder(null)">🏠 Racine</button>
                            @for (var i = 0; i < _breadcrumb.Count; i++)
                            {
                                var folder = _breadcrumb[i];
                                var isLast = i == _breadcrumb.Count - 1;
                                // Téléphone : seuls Racine, le parent direct et le dossier courant restent visibles (« … » pour le reste).
                                var collapsed = i < _breadcrumb.Count - 2;
                                @if (i == 0 && _breadcrumb.Count > 2)
                                {
                                    <span class="doc-crumb-sep doc-crumb-ellipsis" aria-hidden="true">› …</span>
                                }
                                <span class="doc-crumb-sep @(collapsed ? "doc-crumb-mid" : "")" aria-hidden="true">›</span>
                                <button type="button" class="doc-crumb @(isLast ? "active" : "") @(collapsed ? "doc-crumb-mid" : "")"
                                        aria-current="@(isLast ? "page" : null)" @onclick="() => OpenFolder(folder.Id)">@folder.Nom</button>
                            }
                        }
                    </nav>

                    <p class="user-count docs-summary">
                        @if (_visibleFolders.Count > 0)
                        {
                            @(DocumentBrowser.CountLabel(_visibleFolders.Count, "dossier") + " · ")
                        }
                        @DocumentBrowser.CountLabel(_filtered.Count, "document") · tri : @DocumentBrowser.SortLabel(_query.Sort)
                    </p>
                }

                @if (_selectionMode)
                {
                    <div class="sel-bar" role="toolbar" aria-label="Actions groupées">
                        <label class="sel-all">
                            <input type="checkbox" checked="@AllSelected" @onchange="ToggleSelectAll" />
                            <span class="sel-count">@(_selected.Count == 0 ? "Aucun sélectionné" : _selected.Count + " sélectionné(s)")</span>
                        </label>
                        <div class="sel-actions">
                            @if (_view == "docs")
                            {
                                <button class="btn btn-secondary btn-sm" disabled="@(_selected.Count == 0)" @onclick="BatchFav" aria-label="Ajouter aux favoris" title="Ajouter aux favoris">★</button>
                                <button class="btn btn-secondary btn-sm" disabled="@(_selected.Count == 0)" @onclick="() => OpenMove(_selected.ToList())">⤵ Déplacer</button>
                                <button class="btn btn-secondary btn-sm" disabled="@(_selected.Count == 0)" @onclick="BatchShare">↗ Partager</button>
                                <button class="btn btn-danger-outline btn-sm" disabled="@(_selected.Count == 0)" @onclick="AskTrashSelected">🗑 Corbeille</button>
                            }
                            else
                            {
                                <button class="btn btn-secondary btn-sm" disabled="@(_selected.Count == 0)" @onclick="BatchRestore">♻ Restaurer</button>
                                <button class="btn btn-danger-outline btn-sm" disabled="@(_selected.Count == 0)" @onclick="AskPurgeSelected">🗑 Supprimer</button>
                            }
                        </div>
                    </div>
                }

                @if (_view == "docs")
                {
                    @if (_visibleFolders.Count > 0)
                    {
                        <div class="folder-grid">
                            @foreach (var folder in _visibleFolders)
                            {
                                var f = folder;
                                <div class="folder-card" @onclick="() => OpenFolder(f.Id)" role="button" tabindex="0" aria-label="Ouvrir le dossier @f.Nom" @onkeydown="(k) => OnFolderKey(k, f.Id)">
                                    <span class="folder-icon" style="background:@SoftColor(f.Couleur);color:@f.Couleur" aria-hidden="true">📁</span>
                                    <div class="folder-main">
                                        <div class="folder-name">@f.Nom</div>
                                        <div class="folder-sub">@FolderCountLabel(f.Id)</div>
                                    </div>
                                    <div class="folder-actions" @onclick:stopPropagation="true">
                                        <button class="btn-icon" aria-label="Options du dossier @f.Nom" @onclick="() => OpenFolderMenu(f)">⋮</button>
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    @if (_filtered.Count == 0)
                    {
                        @RenderDocsEmpty()
                    }
                    else
                    {
                        <div class="doc-table-head" aria-hidden="true">
                            @if (_selectionMode)
                            {
                                <span class="doc-col-check"></span>
                            }
                            <button type="button" tabindex="-1" class="doc-col-name @SortHeadCls(DocumentBrowser.SortName)" @onclick="() => SetSort(DocumentBrowser.SortName)">Nom</button>
                            <span class="doc-col doc-col-cat">Catégorie</span>
                            <button type="button" tabindex="-1" class="doc-col doc-col-size @SortHeadCls(DocumentBrowser.SortSize)" @onclick="() => SetSort(DocumentBrowser.SortSize)">Taille</button>
                            <button type="button" tabindex="-1" class="doc-col doc-col-date @SortHeadCls(DocumentBrowser.SortRecent, DocumentBrowser.SortOldest)" @onclick="ToggleDateSort">
                                Modifié @(_query.Sort == DocumentBrowser.SortOldest ? "↑" : _query.Sort == DocumentBrowser.SortRecent ? "↓" : "")
                            </button>
                            <span class="doc-col-fav"></span>
                        </div>
                        <div class="doc-list">
                            @foreach (var d in _filtered)
                            {
                                var doc = d;
                                var selected = _selectionMode && _selected.Contains(doc.Id);
                                <div class="doc-card @(selected ? "doc-selected" : "")" @onclick="() => OnDocCardClick(doc)">
                                    @if (_selectionMode)
                                    {
                                        @RenderCheck(doc)
                                    }
                                    @if (DocumentKinds.IsImage(doc.Mime) && !string.IsNullOrWhiteSpace(doc.Data))
                                    {
                                        <img class="doc-thumb" src="@doc.Data" alt="" loading="lazy" />
                                    }
                                    else
                                    {
                                        <span class="doc-thumb doc-thumb-icon" style="background:@SoftColor(DocColor(doc));color:@DocColor(doc)" aria-hidden="true">@DocIcon(doc)</span>
                                    }
                                    <div class="doc-main">
                                        <div class="doc-title" title="@doc.Titre">@doc.Titre</div>
                                        <div class="doc-sub">@FormatSize(doc.Taille) · @ShortDate(doc.DateModification)</div>
                                        <div class="doc-meta">
                                            <span class="badge doc-meta-cat" style="color:@DocumentCategories.Color(doc.Categorie);background:@SoftColor(DocumentCategories.Color(doc.Categorie))">@DocumentCategories.Label(doc.Categorie)</span>
                                            @if (_query.IsGlobalScope && !string.IsNullOrWhiteSpace(doc.FolderId))
                                            {
                                                <span class="badge">📁 @FolderName(doc.FolderId)</span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(doc.UtilisateurId))
                                            {
                                                <span class="badge badge-role">👤 @UserName(doc.UtilisateurId)</span>
                                            }
                                        </div>
                                    </div>
                                    <span class="doc-col doc-col-cat">
                                        <span class="badge" style="color:@DocumentCategories.Color(doc.Categorie);background:@SoftColor(DocumentCategories.Color(doc.Categorie))">@DocumentCategories.Label(doc.Categorie)</span>
                                    </span>
                                    <span class="doc-col doc-col-size">@FormatSize(doc.Taille)</span>
                                    <span class="doc-col doc-col-date">@ShortDate(doc.DateModification)</span>
                                    <button type="button" class="doc-fav @(doc.Favori ? "on" : "")" aria-pressed="@doc.Favori"
                                            aria-label="@(doc.Favori ? "Retirer des favoris" : "Ajouter aux favoris")"
                                            @onclick:stopPropagation="true" @onclick="() => ToggleFav(doc)">★</button>
                                </div>
                            }
                        </div>
                    }
                }
                else
                {
                    @if (_trashCount == 0)
                    {
                        <EmptyState Icon="🗑" Title="Corbeille vide" Message="Les documents supprimés apparaîtront ici et pourront être restaurés." />
                    }
                    else if (_trash.Count == 0)
                    {
                        <EmptyState Icon="🔍" Title="Aucun résultat" Message="@("Aucun document de la corbeille ne correspond à « " + _query.Search.Trim() + " ».")">
                            <button class="btn btn-secondary" @onclick='() => OnSearch("")'>Effacer la recherche</button>
                        </EmptyState>
                    }
                    else
                    {
                        <div class="docs-trash-head">
                            <p class="user-count">@DocumentBrowser.CountLabel(_trash.Count, "document") dans la corbeille</p>
                            <button class="btn btn-danger-outline btn-sm" @onclick="AskEmptyTrash">Vider la corbeille</button>
                        </div>
                        <div class="doc-list doc-list-trash">
                            @foreach (var d in _trash)
                            {
                                var doc = d;
                                var selected = _selectionMode && _selected.Contains(doc.Id);
                                <div class="doc-card @(selected ? "doc-selected" : "")" @onclick="() => OnDocCardClick(doc)">
                                    @if (_selectionMode)
                                    {
                                        @RenderCheck(doc)
                                    }
                                    <span class="doc-thumb doc-thumb-icon" style="background:var(--surface-2);color:var(--text-muted)" aria-hidden="true">@DocIcon(doc)</span>
                                    <div class="doc-main">
                                        <div class="doc-title" title="@doc.Titre">@doc.Titre</div>
                                        <div class="doc-sub">Supprimé le @ShortDateTime(doc.DateSuppression) · @FormatSize(doc.Taille)</div>
                                    </div>
                                    @if (!_selectionMode)
                                    {
                                        <div class="doc-trash-actions" @onclick:stopPropagation="true">
                                            <button class="btn btn-secondary btn-sm" @onclick="() => DoRestore(doc.Id)">♻ Restaurer</button>
                                            <button class="btn-icon danger" aria-label="Supprimer définitivement @doc.Titre" @onclick="() => AskPurge(doc)">🗑</button>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                }
            </section>
        </div>

        @if (!_selectionMode && _view == "docs")
        {
            <button class="fab" aria-label="Ajouter un document ou un dossier" @onclick="() => _fabOpen = true">+</button>
        }
    </div>

    <Modal Show="_fabOpen" Title="Ajouter" OnClose="() => _fabOpen = false">
        <div class="import-format" style="margin-bottom:10px">
            <div class="import-format-title">📋 Formats acceptés : PDF, JPG, PNG, GIF, WEBP, TXT, DOC, DOCX, XLS, XLSX, ZIP, MP3, MP4 — max 10 Mo.</div>
        </div>
        @if (_currentFolderId != null)
        {
            <p class="field-hint" style="margin:0 0 10px">Destination : 📁 @FolderPath(_currentFolderId)</p>
        }
        <div class="sheet-options">
            <button class="sheet-option" @onclick="StartNewFolder">
                <span class="sheet-icon" style="background:#4f46e524;color:#4f46e5">📁</span>
                <span class="sheet-main"><strong>@(_currentFolderId == null ? "Nouveau dossier" : "Nouveau sous-dossier")</strong><span>Créer un dossier de classement</span></span>
                <span aria-hidden="true">›</span>
            </button>
            <button class="sheet-option" @onclick="ImportFile">
                <span class="sheet-icon" style="background:#0891b224;color:#0891b2">📄</span>
                <span class="sheet-main"><strong>Importer un fichier</strong><span>PDF, image, DOCX, XLSX, TXT, ZIP… (max 10 Mo)</span></span>
                <span aria-hidden="true">›</span>
            </button>
            <button class="sheet-option" @onclick="ImportImage">
                <span class="sheet-icon" style="background:#05966924;color:#059669">🖼</span>
                <span class="sheet-main"><strong>Choisir une image</strong><span>JPG, PNG, GIF, WEBP depuis la galerie (max 10 Mo)</span></span>
                <span aria-hidden="true">›</span>
            </button>
            <button class="sheet-option" @onclick="OpenScan">
                <span class="sheet-icon" style="background:#dc262624;color:#dc2626">📷</span>
                <span class="sheet-main"><strong>Scanner un document</strong><span>Photos JPEG → PDF</span></span>
                <span aria-hidden="true">›</span>
            </button>
        </div>
    </Modal>

    <Modal Show="_folderModal" Title="@(_editingFolder == null ? "Nouveau dossier" : "Renommer le dossier")" OnClose="CloseFolderModal">
        <div class="form-group">
            <label for="doc-folder-name">Nom du dossier *</label>
            <input id="doc-folder-name" type="text" placeholder="Ex : Factures 2026" value="@_folderName" @oninput="e => _folderName = e.Value?.ToString() ?? string.Empty" />
        </div>
        <div class="form-group">
            <label>Couleur</label>
            <div class="color-swatches">
                @foreach (var c in FolderColors)
                {
                    <button type="button" class="color-swatch @(c == _folderColor ? "selected" : "")"
                            style="background:@c" title="@c" aria-label="Couleur @c" @onclick="() => _folderColor = c"></button>
                }
            </div>
        </div>
        <span class="form-error">@_folderError</span>
        <div class="form-actions filter-actions">
            <button type="button" class="btn btn-secondary" @onclick="CloseFolderModal">Annuler</button>
            <button type="button" class="btn btn-primary" @onclick="SaveFolder">Enregistrer</button>
        </div>
    </Modal>

    <Modal Show="_folderMenu != null && !_confirmDeleteFolder" Title="@(_folderMenu == null ? "" : _folderMenu.Nom)" OnClose="() => _folderMenu = null">
        <div class="sheet-options">
            <button class="sheet-option" @onclick="() => StartRenameFolder(_folderMenu!)">
                <span class="sheet-icon" style="background:#4f46e524;color:#4f46e5">✏️</span>
                <span class="sheet-main"><strong>Renommer</strong></span>
                <span aria-hidden="true">›</span>
            </button>
            <button class="sheet-option" @onclick="() => AskDeleteFolder(_folderMenu!)">
                <span class="sheet-icon" style="background:#dc262624;color:#dc2626">🗑</span>
                <span class="sheet-main"><strong>Supprimer le dossier</strong><span>Le contenu sera conservé (remonté au dossier parent)</span></span>
                <span aria-hidden="true">›</span>
            </button>
        </div>
    </Modal>

    <Modal Show="_staged != null" Title="Importer un document" OnClose="CancelImport">
        <ChildContent>
            @if (_staged != null)
            {
                <p class="muted" style="margin-top:0">📎 @_staged.FileName · @_staged.Mime · @FormatSize(_staged.Size)</p>
                <div class="import-format" style="margin-bottom:10px">
                    <div class="import-format-title">Contenu : @KindName(_staged.Mime) — formats : PDF, images (JPG/PNG/GIF/WEBP), TXT, DOC(X), XLS(X), ZIP, MP3, MP4. Taille max 10 Mo.</div>
                </div>
                <div class="form-group">
                    <label for="doc-import-titre">Titre *</label>
                    <input id="doc-import-titre" type="text" value="@_iTitre" @oninput="e => _iTitre = e.Value?.ToString() ?? string.Empty" />
                </div>
                <div class="form-group">
                    <label for="doc-import-desc">Description</label>
                    <textarea id="doc-import-desc" rows="2" value="@_iDesc" @oninput="e => _iDesc = e.Value?.ToString() ?? string.Empty"></textarea>
                </div>
                <div class="form-group">
                    <label for="doc-import-cat">Catégorie</label>
                    <select id="doc-import-cat" value="@_iCat" @onchange="e => _iCat = e.Value?.ToString() ?? DocumentCategories.Autre">
                        @foreach (var c in DocumentCategories.Toutes)
                        {
                            <option value="@c">@DocumentCategories.Icon(c) @DocumentCategories.Label(c)</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label for="doc-import-tags">Tags (séparés par des virgules)</label>
                    <input id="doc-import-tags" type="text" placeholder="Ex : urgent, maison" value="@_iTags" @oninput="e => _iTags = e.Value?.ToString() ?? string.Empty" />
                </div>
                <div class="form-group">
                    <label for="doc-import-folder">Dossier</label>
                    <select id="doc-import-folder" value="@_iFolder" @onchange="e => _iFolder = e.Value?.ToString() ?? string.Empty">
                        @RenderFolderOptions()
                    </select>
                </div>
                <div class="form-group">
                    <label for="doc-import-user">Utilisateur associé</label>
                    <select id="doc-import-user" value="@_iUser" @onchange="e => _iUser = e.Value?.ToString() ?? string.Empty">
                        <option value="">— Aucun —</option>
                        @foreach (var u in _activeUsers)
                        {
                            <option value="@u.Identifiant">@u.NomComplet</option>
                        }
                    </select>
                </div>
                <span class="form-error">@_importError</span>
            }
        </ChildContent>
        <FooterContent>
            <button type="button" class="btn btn-secondary" @onclick="CancelImport">Annuler</button>
            <button type="button" class="btn btn-primary" @onclick="SaveImport" disabled="@(_saving || _staged == null)">Enregistrer</button>
        </FooterContent>
    </Modal>

    <Modal Show="_scanOpen" Title="Scanner un document" OnClose="CloseScan">
        <ChildContent>
            @if (_scanPages.Count == 0)
            {
                <EmptyState Icon="📷" Title="Aucune page" Message="Photographiez chaque page du document, puis convertissez l'ensemble en PDF." />
            }
            else
            {
                <div class="scan-thumbs">
                    @for (var i = 0; i < _scanPages.Count; i++)
                    {
                        var idx = i;
                        var page = _scanPages[idx];
                        <div class="scan-thumb">
                            <img src="@ScanPreviewUrl(page)" alt="Page @(idx + 1)" />
                            <span class="scan-num">@(idx + 1)</span>
                            <button type="button" class="scan-remove" aria-label="Retirer la page @(idx + 1)" @onclick="() => RemoveScanPage(idx)">×</button>
                        </div>
                    }
                </div>
            }
            <div class="inline-actions" style="margin:10px 0">
                <button type="button" class="btn btn-secondary btn-sm" @onclick="ScanCapture">📷 Capturer une page</button>
                <button type="button" class="btn btn-secondary btn-sm" @onclick="ScanGallery">🖼 Depuis la galerie</button>
            </div>
            <div class="form-group">
                <label for="doc-scan-titre">Titre du PDF *</label>
                <input id="doc-scan-titre" type="text" placeholder="Ex : Contrat signé" value="@_scanTitre" @oninput="e => _scanTitre = e.Value?.ToString() ?? string.Empty" />
            </div>
            <span class="form-error">@_scanError</span>
            <span class="field-hint">Seules les photos JPEG (caméra) peuvent être converties en PDF.</span>
        </ChildContent>
        <FooterContent>
            <button type="button" class="btn btn-secondary" @onclick="CloseScan">Annuler</button>
            <button type="button" class="btn btn-primary" @onclick="ConvertScan" disabled="@(_saving || _scanPages.Count == 0)">Convertir en PDF (@_scanPages.Count p.)</button>
        </FooterContent>
    </Modal>

    <Modal Show="_detail != null" Title="@(_detail == null ? "" : _detail.Titre)" OnClose="() => _detail = null">
        <ChildContent>
            @if (_detail != null)
            {
                var doc = _detail;
                @if (DocumentKinds.IsImage(doc.Mime) && !string.IsNullOrWhiteSpace(doc.Data))
                {
                    <div class="doc-preview-wrap">
                        <img class="doc-preview-img" src="@doc.Data" alt="@doc.Titre" />
                    </div>
                }
                else
                {
                    <div class="doc-preview-file" style="--doc-color:@DocColor(doc)">
                        <span class="doc-preview-icon" aria-hidden="true">@DocIcon(doc)</span>
                        <div><strong>@doc.FileName</strong><span>@KindName(doc.Mime) · @FormatSize(doc.Taille)</span></div>
                        <div class="file-actions">
                            <button type="button" class="btn btn-secondary btn-sm" @onclick="() => OpenDoc(doc)">⇱ Ouvrir</button>
                            <button type="button" class="btn btn-secondary btn-sm" @onclick="() => SaveDoc(doc)">⇩ Enregistrer</button>
                        </div>
                    </div>
                    @if (IsTextPreviewable(doc))
                    {
                        <div class="cal-detail-notes" style="max-height:220px;overflow:auto">@TextPreview(doc)</div>
                    }
                    else if (DocumentKinds.IsPdf(doc.Mime) && !string.IsNullOrWhiteSpace(doc.Data))
                    {
                        <div class="doc-pdf-preview">
                            <iframe src="@doc.Data" title="Aperçu @doc.Titre" class="doc-pdf-frame"></iframe>
                            <span class="field-hint">Si l'aperçu ne s'affiche pas, utilisez « Ouvrir » ou « Enregistrer ».</span>
                        </div>
                    }
                }
                <div class="doc-detail-lines">
                    <div class="storage-line"><span>Catégorie</span><strong>@DocumentCategories.Icon(doc.Categorie) @DocumentCategories.Label(doc.Categorie)</strong></div>
                    <div class="storage-line"><span>Dossier</span><strong>@(string.IsNullOrWhiteSpace(doc.FolderId) ? "🏠 Racine" : "📁 " + FolderPath(doc.FolderId))</strong></div>
                    <div class="storage-line"><span>Ajouté le</span><strong>@ShortDateTime(doc.DateCreation)</strong></div>
                    <div class="storage-line"><span>Ajouté par</span><strong>👤 @UserName(doc.CreatedBy)</strong></div>
                    <div class="storage-line"><span>Modifié le</span><strong>@ShortDateTime(doc.DateModification)</strong></div>
                    @if (!string.IsNullOrWhiteSpace(doc.ModifiePar))
                    {
                        <div class="storage-line"><span>Modifié par</span><strong>👤 @UserName(doc.ModifiePar)</strong></div>
                    }
                    @if (!string.IsNullOrWhiteSpace(doc.UtilisateurId))
                    {
                        <div class="storage-line"><span>Associé à</span><strong>👤 @UserName(doc.UtilisateurId)</strong></div>
                    }
                    @if (doc.Tags.Count > 0)
                    {
                        <div class="doc-tags">@foreach (var t in doc.Tags)
                        {
                            <span class="tag-chip">🏷 @t</span>
                        }</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(doc.Description))
                    {
                        <div class="cal-detail-notes">@doc.Description</div>
                    }
                </div>
            }
        </ChildContent>
        <FooterContent>
            @if (_detail != null && !_detail.Supprime)
            {
                <button type="button" class="btn btn-secondary" @onclick="() => _detail = null">Réduire</button>
                <button type="button" class="btn btn-secondary" @onclick="() => ShareDocs(new[] { _detail! })">↗ Partager</button>
                <button type="button" class="btn btn-secondary" @onclick="() => StartEdit(_detail!)">✏️ Modifier</button>
                <button type="button" class="btn btn-danger-outline" @onclick="() => AskTrash(new[] { _detail!.Id })">🗑 Supprimer</button>
            }
            else
            {
                <button type="button" class="btn btn-secondary" @onclick="() => _detail = null">Réduire</button>
                <button type="button" class="btn btn-primary" @onclick="() => DoRestore((_detail!).Id)">♻ Restaurer</button>
            }
        </FooterContent>
    </Modal>

    <Modal Show="_editing != null" Title="Modifier le document" OnClose="() => _editing = null">
        <ChildContent>
            <div class="form-group">
                <label for="doc-edit-titre">Titre *</label>
                <input id="doc-edit-titre" type="text" value="@_eTitre" @oninput="e => _eTitre = e.Value?.ToString() ?? string.Empty" />
            </div>
            <div class="form-group">
                <label for="doc-edit-desc">Description</label>
                <textarea id="doc-edit-desc" rows="2" value="@_eDesc" @oninput="e => _eDesc = e.Value?.ToString() ?? string.Empty"></textarea>
            </div>
            <div class="form-group">
                <label for="doc-edit-cat">Catégorie</label>
                <select id="doc-edit-cat" value="@_eCat" @onchange="e => _eCat = e.Value?.ToString() ?? DocumentCategories.Autre">
                    @foreach (var c in DocumentCategories.Toutes)
                    {
                        <option value="@c">@DocumentCategories.Icon(c) @DocumentCategories.Label(c)</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label for="doc-edit-tags">Tags (séparés par des virgules)</label>
                <input id="doc-edit-tags" type="text" value="@_eTags" @oninput="e => _eTags = e.Value?.ToString() ?? string.Empty" />
            </div>
            <div class="form-group">
                <label for="doc-edit-folder">Dossier</label>
                <select id="doc-edit-folder" value="@_eFolder" @onchange="e => _eFolder = e.Value?.ToString() ?? string.Empty">
                    @RenderFolderOptions()
                </select>
            </div>
            <div class="form-group">
                <label for="doc-edit-user">Utilisateur associé</label>
                <select id="doc-edit-user" value="@_eUser" @onchange="e => _eUser = e.Value?.ToString() ?? string.Empty">
                    <option value="">— Aucun —</option>
                    @foreach (var u in _activeUsers)
                    {
                        <option value="@u.Identifiant">@u.NomComplet</option>
                    }
                </select>
            </div>
            <span class="form-error">@_editError</span>
        </ChildContent>
        <FooterContent>
            <button type="button" class="btn btn-secondary" @onclick="() => _editing = null">Annuler</button>
            <button type="button" class="btn btn-primary" @onclick="SaveEdit">Enregistrer</button>
        </FooterContent>
    </Modal>

    <Modal Show="_moveOpen" Title="Déplacer vers…" OnClose="() => _moveOpen = false">
        <div class="move-list">
            <label class="form-check">
                <input type="radio" name="doc-move" checked="@(_moveTarget == "")" @onchange='() => _moveTarget = ""' />
                🏠 Racine
            </label>
            @foreach (var (id, path) in _folderOptions)
            {
                var folderId = id;
                <label class="form-check">
                    <input type="radio" name="doc-move" checked="@(_moveTarget == folderId)" @onchange="() => _moveTarget = folderId" />
                    📁 @path
                </label>
            }
        </div>
        <div class="form-actions filter-actions">
            <button type="button" class="btn btn-secondary" @onclick="() => _moveOpen = false">Annuler</button>
            <button type="button" class="btn btn-primary" @onclick="DoMove">Déplacer (@_moveIds.Count)</button>
        </div>
    </Modal>

    <Modal Show="_filtersOpen" Title="Filtrer et trier" OnClose="() => _filtersOpen = false">
        <div class="cal-filter-section">
            <div class="divider-section">Catégories</div>
            <div class="check-group">
                @foreach (var c in DocumentCategories.Toutes)
                {
                    var cat = c;
                    <label class="form-check">
                        <input type="checkbox" checked="@_query.Categories.Contains(cat)" @onchange="() => ToggleCat(cat)" />
                        <span style="color:@DocumentCategories.Color(cat)">@DocumentCategories.Icon(cat)</span> @DocumentCategories.Label(cat)
                    </label>
                }
            </div>
            <div class="divider-section">Type de fichier</div>
            <div class="radio-row">
                @foreach (var (key, label) in DocumentBrowser.KindChoices)
                {
                    var k = key;
                    <label class="radio-option">
                        <input type="radio" name="doc-kind" checked="@(_query.Kind == k)" @onchange="() => SetKind(k)" />
                        @label
                    </label>
                }
            </div>
            <div class="divider-section">Options</div>
            <div class="check-group">
                <label class="form-check">
                    <input type="checkbox" checked="@_query.FavoritesOnly" @onchange="ToggleFavOnly" />
                    ⭐ Favoris uniquement (tous les dossiers)
                </label>
            </div>
            <div class="divider-section">Utilisateur associé</div>
            <div class="radio-row">
                <label class="radio-option">
                    <input type="radio" name="doc-user" checked="@(_query.UserId == null)" @onchange="() => SetUser(null)" />
                    Tous
                </label>
                @foreach (var u in _activeUsers)
                {
                    var user = u;
                    <label class="radio-option">
                        <input type="radio" name="doc-user" checked="@(_query.UserId == user.Identifiant)" @onchange="() => SetUser(user.Identifiant)" />
                        @user.NomComplet
                    </label>
                }
            </div>
            <div class="divider-section">Tri</div>
            <div class="radio-row">
                @foreach (var (key, label) in DocumentBrowser.SortChoices)
                {
                    var k = key;
                    <label class="radio-option">
                        <input type="radio" name="doc-sort" checked="@(_query.Sort == k)" @onchange="() => SetSort(k)" />
                        @label
                    </label>
                }
            </div>
        </div>
        <div class="form-actions filter-actions">
            <button type="button" class="btn btn-secondary" @onclick="ResetFilters">Réinitialiser</button>
            <button type="button" class="btn btn-primary" @onclick="() => _filtersOpen = false">Voir @DocumentBrowser.CountLabel(_filtered.Count, "document")</button>
        </div>
    </Modal>

    <ConfirmDialog Show="_confirmTrash" Title="Placer dans la corbeille"
                   Message="@("Placer " + _pendingIds.Count + " document(s) dans la corbeille ? Vous pourrez les restaurer.")"
                   ConfirmLabel="Mettre à la corbeille" Danger="true" OnConfirm="DoTrash" OnCancel="() => _confirmTrash = false" />

    <ConfirmDialog Show="_confirmPurge" Title="Supprimer définitivement"
                   Message="@PurgeMessage"
                   ConfirmLabel="Supprimer" Danger="true" OnConfirm="DoPurge" OnCancel="CancelPurge" />

    <ConfirmDialog Show="_confirmEmptyTrash" Title="Vider la corbeille"
                   Message="Supprimer définitivement tous les documents de la corbeille ? Action irréversible."
                   ConfirmLabel="Tout supprimer" Danger="true" OnConfirm="DoEmptyTrash" OnCancel="() => _confirmEmptyTrash = false" />

    <ConfirmDialog Show="_confirmDeleteFolder" Title="Supprimer le dossier"
                   Message="@(_folderMenu == null ? "" : "Supprimer le dossier « " + _folderMenu.Nom + " » ? Son contenu sera conservé et remonté au dossier parent.")"
                   ConfirmLabel="Supprimer" Danger="true" OnConfirm="DoDeleteFolder" OnCancel="CancelDeleteFolder" />
}

@code {
    private static readonly string[] FolderColors =
    {
        "#4f46e5", "#0891b2", "#059669", "#d97706", "#dc2626", "#7c3aed", "#0ea5e9", "#64748b"
    };

    private long QuotaBytes => Store.CurrentStorageQuotaBytes;

    private string _error = "";
    private string _view = "docs";
    private string? _currentFolderId;
    private readonly DocumentQuery _query = new();
    private bool _filtersOpen;
    private bool _saving;

    private bool _selectionMode;
    private readonly HashSet<string> _selected = new();

    private bool _fabOpen;
    private bool _folderModal;
    private DocumentFolder? _editingFolder;
    private string _folderName = "";
    private string _folderColor = FolderColors[0];
    private string _folderError = "";
    private DocumentFolder? _folderMenu;
    private bool _confirmDeleteFolder;

    private DocImport? _staged;
    private string _iTitre = "";
    private string _iDesc = "";
    private string _iCat = DocumentCategories.Autre;
    private string _iTags = "";
    private string _iFolder = "";
    private string _iUser = "";
    private string _importError = "";

    private bool _scanOpen;
    private readonly List<DocImport> _scanPages = new();
    private string _scanTitre = "";
    private string _scanError = "";

    private DocumentItem? _detail;
    private DocumentItem? _editing;
    private string _eTitre = "";
    private string _eDesc = "";
    private string _eCat = DocumentCategories.Autre;
    private string _eTags = "";
    private string _eFolder = "";
    private string _eUser = "";
    private string _editError = "";

    private bool _moveOpen;
    private List<string> _moveIds = new();
    private string _moveTarget = "";

    private bool _confirmTrash;
    private bool _confirmPurge;
    private bool _confirmEmptyTrash;
    private List<string> _pendingIds = new();
    private List<DocumentItem> _purgeTargets = new();

    // Résultats affichés (recalculés à chaque changement de critère).
    private List<DocumentItem> _filtered = new();
    private List<DocumentItem> _trash = new();
    private List<DocumentFolder> _visibleFolders = new();
    private List<DocumentFolder> _breadcrumb = new();

    // Caches dérivés du magasin (recalculés uniquement quand les données changent).
    private Dictionary<string, DocumentFolder> _folderById = new();
    private List<(DocumentFolder Folder, int Depth)> _tree = new();
    private List<(string Id, string Path)> _folderOptions = new();
    private Dictionary<string, int> _itemCounts = new();
    private Dictionary<string, string> _userNames = new();
    private List<UserAccount> _activeUsers = new();
    private int _docCount;
    private int _favCount;
    private int _trashCount;
    private long _usedBytes;
    private bool _quotaAlmostFull;
    private double _quotaPercent;

    protected override void OnInitialized()
    {
        Store.DataChanged += OnChanged;
        try
        {
            RefreshData();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private void RetryLoad()
    {
        _error = "";
        try { RefreshData(); }
        catch (Exception ex) { _error = ex.Message; }
        StateHasChanged();
    }

    private void OnChanged() => _ = InvokeAsync(() => { RefreshData(); StateHasChanged(); });

    /// <summary>Reconstruit les caches (dossiers, compteurs, utilisateurs, stockage) puis la liste.
    /// Appelé à l'ouverture et à chaque modification des données — pas à chaque frappe.</summary>
    private void RefreshData()
    {
        var folders = Store.Folders;
        _folderById = folders.ToDictionary(f => f.Id, StringComparer.Ordinal);
        _tree = DocumentBrowser.FolderTree(folders);
        _folderOptions = _tree.Select(t => (t.Folder.Id, DocumentBrowser.FolderPath(_folderById, t.Folder.Id))).ToList();
        _itemCounts = DocumentBrowser.ItemCounts(Store.Documents, folders);

        _userNames = new Dictionary<string, string>(StringComparer.Ordinal);
        foreach (var u in Store.Users)
            if (!string.IsNullOrWhiteSpace(u.Identifiant)) _userNames.TryAdd(u.Identifiant, u.NomComplet);
        _activeUsers = Store.Users.Where(u => u.Actif).OrderBy(u => u.NomComplet).ToList();

        _docCount = 0; _favCount = 0; _trashCount = 0;
        var ids = new HashSet<string>(StringComparer.Ordinal);
        foreach (var d in Store.Documents)
        {
            ids.Add(d.Id);
            if (d.Supprime) { _trashCount++; continue; }
            _docCount++;
            if (d.Favori) _favCount++;
        }
        _selected.RemoveWhere(id => !ids.Contains(id));

        // Dossier courant supprimé ailleurs : retour à la racine.
        if (_currentFolderId != null && !_folderById.ContainsKey(_currentFolderId)) _currentFolderId = null;

        _usedBytes = Store.StorageUsedBytes();
        _quotaPercent = QuotaBytes > 0 ? Math.Min((double)_usedBytes / QuotaBytes * 100.0, 100.0) : 0;
        // En ligne, la place se surveille dans « Capacité du serveur » (quota Supabase), pas ici.
        _quotaAlmostFull = false;

        ApplyFilters();
    }

    /// <summary>Recalcule uniquement la liste visible (recherche, filtres, tri, dossier courant).</summary>
    private void ApplyFilters()
    {
        _query.FolderId = _currentFolderId;
        _filtered = DocumentBrowser.Filter(Store.Documents, _query);

        var term = _query.Search.Trim();
        _trash = Store.Documents
            .Where(d => d.Supprime && (term.Length == 0 || DocumentBrowser.Matches(d.Titre, term) || DocumentBrowser.Matches(d.FileName, term)))
            .OrderByDescending(d => d.DateSuppression, StringComparer.Ordinal).ToList();

        _visibleFolders = _query.IsGlobalScope
            ? new List<DocumentFolder>()
            : _tree.Where(t => string.Equals(t.Folder.ParentId ?? "", _currentFolderId ?? "", StringComparison.Ordinal)
                               || (_currentFolderId == null && t.Depth == 0))
                   .Select(t => t.Folder).ToList();

        _breadcrumb = DocumentBrowser.Breadcrumb(_folderById, _currentFolderId);
    }

    /// <summary>Liste actuellement affichée (documents ou corbeille), cible de la sélection.</summary>
    private List<DocumentItem> CurrentList => _view == "docs" ? _filtered : _trash;

    private bool AllSelected => CurrentList.Count > 0 && CurrentList.All(d => _selected.Contains(d.Id));

    private bool IsTreeActive(string? folderId) =>
        _view == "docs" && !_query.IsGlobalScope && _currentFolderId == folderId;

    private void SetView(string v)
    {
        _view = v;
        _selected.Clear();
        _selectionMode = false;
        ApplyFilters();
    }

    private void ShowAllDocuments()
    {
        _query.FavoritesOnly = false;
        SetView("docs");
    }

    private void ShowFavorites()
    {
        _query.FavoritesOnly = true;
        SetView("docs");
    }

    private void OpenFolder(string? id)
    {
        _currentFolderId = string.IsNullOrWhiteSpace(id) ? null : id;
        _view = "docs";
        // Ouvrir un dossier sort de la recherche et de la vue Favoris globale.
        _query.Search = "";
        _query.FavoritesOnly = false;
        _selected.Clear();
        ApplyFilters();
    }

    private void GoUp() => OpenFolder(_currentFolderId == null ? null : _folderById.GetValueOrDefault(_currentFolderId)?.ParentId);

    private void OnFolderKey(KeyboardEventArgs k, string id)
    {
        if (k.Key is "Enter" or " ") OpenFolder(id);
    }

    private void OnSearch(string value)
    {
        _query.Search = value;
        ApplyFilters();
    }

    private void OnSort(ChangeEventArgs e) => SetSort(e.Value?.ToString() ?? DocumentBrowser.SortRecent);

    private void SetSort(string sort)
    {
        _query.Sort = sort;
        ApplyFilters();
    }

    private void ToggleDateSort() =>
        SetSort(_query.Sort == DocumentBrowser.SortRecent ? DocumentBrowser.SortOldest : DocumentBrowser.SortRecent);

    private string SortHeadCls(params string[] keys) => keys.Contains(_query.Sort) ? "sorted" : "";

    private void SetKind(string kind)
    {
        _query.Kind = kind;
        ApplyFilters();
    }

    private void SetUser(string? userId)
    {
        _query.UserId = userId;
        ApplyFilters();
    }

    private void ToggleCat(string cat)
    {
        if (!_query.Categories.Add(cat)) _query.Categories.Remove(cat);
        ApplyFilters();
    }

    private void ToggleFavOnly()
    {
        _query.FavoritesOnly = !_query.FavoritesOnly;
        ApplyFilters();
    }

    private void ClearQuickFilters()
    {
        _query.Kind = DocumentBrowser.KindAll;
        _query.FavoritesOnly = false;
        ApplyFilters();
    }

    private void ResetFilters()
    {
        _query.ResetFilters();
        ApplyFilters();
    }

    private void ClearSearchAndFilters()
    {
        _query.Search = "";
        _query.ResetFilters();
        ApplyFilters();
    }

    private void ToggleSelectMode()
    {
        _selectionMode = !_selectionMode;
        _selected.Clear();
    }

    private void ToggleSelectAll()
    {
        if (AllSelected) _selected.Clear();
        else foreach (var d in CurrentList) _selected.Add(d.Id);
    }

    /// <summary>Clic sur une carte : bascule la sélection en mode sélection, sinon ouvre le détail.</summary>
    private void OnDocCardClick(DocumentItem doc)
    {
        if (_selectionMode) ToggleSelected(doc.Id);
        else OpenDetail(doc);
    }

    private void OnCheckKey(KeyboardEventArgs k, string id)
    {
        if (k.Key is "Enter" or " ") ToggleSelected(id);
    }

    private void ToggleSelected(string id)
    {
        if (!_selected.Add(id)) _selected.Remove(id);
    }

    private RenderFragment RenderCheck(DocumentItem doc) => __builder =>
    {
        <span class="doc-check" @onclick:stopPropagation="true" @onclick="() => ToggleSelected(doc.Id)" role="checkbox" aria-checked="@(_selected.Contains(doc.Id) ? "true" : "false")" aria-label="Sélectionner @doc.Titre" tabindex="0" @onkeydown="(k) => OnCheckKey(k, doc.Id)">
            <input type="checkbox" checked="@_selected.Contains(doc.Id)" tabindex="-1" aria-hidden="true" />
        </span>
    };

    private RenderFragment RenderFolderOptions() => __builder =>
    {
        <option value="">🏠 Racine</option>
        @foreach (var (id, path) in _folderOptions)
        {
            <option value="@id">📁 @path</option>
        }
    };

    /// <summary>État vide contextualisé : aucun document, dossier vide, favoris vides ou aucun résultat.</summary>
    private RenderFragment RenderDocsEmpty() => __builder =>
    {
        var onlyFavorites = _query.FavoritesOnly && !_query.IsSearching && _query.ActiveFilterCount == 1;
        if (_docCount == 0 && _folderById.Count == 0)
        {
            <EmptyState Icon="📁" Title="Aucun document" Message="Importez un fichier, scannez un document ou créez un dossier pour classer vos fichiers.">
                <button class="btn btn-primary" @onclick="() => _fabOpen = true">+ Ajouter un document</button>
                <button class="btn btn-secondary" @onclick="StartNewFolder">Nouveau dossier</button>
            </EmptyState>
        }
        else if (onlyFavorites)
        {
            <EmptyState Icon="★" Title="Aucun favori" Message="Touchez l'étoile d'un document pour le retrouver ici, quel que soit son dossier.">
                <button class="btn btn-secondary" @onclick="ShowAllDocuments">Voir tous les documents</button>
            </EmptyState>
        }
        else if (_query.IsSearching || _query.HasActiveFilters)
        {
            var message = _query.IsSearching
                ? "Aucun document ne correspond à « " + _query.Search.Trim() + " »" + (_query.HasActiveFilters ? " avec les filtres actifs." : ".")
                : "Aucun document de ce dossier ne correspond aux filtres actifs.";
            <EmptyState Icon="🔍" Title="Aucun résultat" Message="@message">
                <button class="btn btn-secondary" @onclick="ClearSearchAndFilters">Effacer la recherche et les filtres</button>
            </EmptyState>
        }
        else if (_visibleFolders.Count > 0)
        {
            <p class="docs-hint">Aucun document directement dans @(_currentFolderId == null ? "la racine" : "ce dossier") : ouvrez un dossier ci-dessus.</p>
        }
        else
        {
            <EmptyState Icon="📂" Title="@(_currentFolderId == null ? "Racine vide" : "Ce dossier est vide")" Message="Ajoutez un document ici ou créez un sous-dossier pour classer vos fichiers.">
                <button class="btn btn-primary" @onclick="() => _fabOpen = true">+ Ajouter un document</button>
                <button class="btn btn-secondary" @onclick="StartNewFolder">Nouveau dossier</button>
            </EmptyState>
        }
    };

