    private void DoEmptyTrash()
    {
        _confirmEmptyTrash = false;
        var res = Store.EmptyTrash();
        _selected.Clear();
        _selectionMode = false;
        if (res.Success) State.NotifySuccess("Corbeille vidée.");
        else State.NotifyError(res.Error);
    }

    // ---------- Helpers ----------

    private static List<string> SplitTags(string raw) => (raw ?? "")
        .Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)
        .Distinct(StringComparer.OrdinalIgnoreCase).ToList();

    private static byte[]? DocBytes(DocumentItem doc)
    {
        try
        {
            var data = doc.Data ?? "";
            var comma = data.IndexOf(',');
            var b64 = comma >= 0 ? data[(comma + 1)..] : data;
            // Tolère les espaces/retours issus d'un copier-coller ou d'un paquet édité.
            b64 = new string(b64.Where(c => !char.IsWhiteSpace(c)).ToArray());
            if (b64.Length == 0) return null;
            var bytes = Convert.FromBase64String(b64);
            return bytes.Length == 0 ? null : bytes;
        }
        catch { return null; }
    }

    /// <summary>Nom de fichier sûr : séparateurs et caractères interdits remplacés,
    /// longueur plafonnée (accents conservés).</summary>
    private static string SanitizeFileName(string? raw, string fallback = "fichier")
    {
        var invalid = new HashSet<char>(Path.GetInvalidFileNameChars());
        foreach (var c in new[] { ':', '*', '?', '"', '<', '>', '|', '/', '\\' }) invalid.Add(c);
        var sb = new System.Text.StringBuilder();
        foreach (var c in (raw ?? "")) sb.Append(invalid.Contains(c) || char.IsControl(c) ? '_' : c);
        var safe = sb.ToString().Trim().Trim('.');
        if (safe.Length > 100) safe = safe[..100].Trim().Trim('.');
        return string.IsNullOrWhiteSpace(safe) ? fallback : safe;
    }

    private string UserName(string? identifiant) =>
        identifiant != null && _userNames.TryGetValue(identifiant, out var name) ? name : (identifiant ?? "");

    private static string DocIcon(DocumentItem doc) => DocumentKinds.KindOf(doc.Mime) switch
    {
        "pdf" => "📕",
        "image" => "🖼️",
        _ => doc.Mime.StartsWith("text/", StringComparison.OrdinalIgnoreCase) ? "📝"
            : doc.Mime.StartsWith("audio/", StringComparison.OrdinalIgnoreCase) ? "🎵"
            : doc.Mime.StartsWith("video/", StringComparison.OrdinalIgnoreCase) ? "🎬" : "📎"
    };

    private static string DocColor(DocumentItem doc) => DocumentKinds.KindOf(doc.Mime) switch
    {
        "pdf" => "#dc2626",
        "image" => "#059669",
        _ => DocumentCategories.Color(doc.Categorie)
    };

    private static string KindName(string? mime) => DocumentKinds.KindOf(mime) switch
    {
        "pdf" => "Document PDF",
        "image" => "Image",
        _ => string.IsNullOrWhiteSpace(mime) ? "Fichier" : mime
    };

    private static string SoftColor(string hex) => hex.Length == 7 ? hex + "24" : hex;

    private static string FormatSize(long bytes)
    {
        if (bytes < 1024) return bytes + " o";
        if (bytes < 1024 * 1024) return (bytes / 1024.0).ToString("0.0") + " Ko";
        if (bytes < 1024L * 1024L * 1024L) return (bytes / (1024.0 * 1024)).ToString("0.0") + " Mo";
        return (bytes / (1024.0 * 1024 * 1024)).ToString("0.0") + " Go";
    }

    private static string ShortDate(string? iso) => DataStore.FormatDateCourte(iso);

    private static string ShortDateTime(string? iso) => DataStore.FormatDateCourte(iso);

