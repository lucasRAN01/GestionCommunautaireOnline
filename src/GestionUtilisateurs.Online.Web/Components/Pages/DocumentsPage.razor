    private static bool IsTextPreviewable(DocumentItem doc)
    {
        if (string.IsNullOrWhiteSpace(doc.Data)) return false;
        return (doc.Mime ?? "").StartsWith("text/", StringComparison.OrdinalIgnoreCase);
    }

    private static string TextPreview(DocumentItem doc)
    {
        try
        {
            var bytes = DocBytes(doc);
            if (bytes == null) return "";
            // Détecte le BOM, sinon UTF-8, sinon Latin1 (fichiers Windows-1252 : é/è/à).
            var text = DecodeText(bytes);
            return TruncateSafe(text, 4000);
        }
        catch { return ""; }
    }

    private static string DecodeText(byte[] bytes)
    {
        if (bytes.Length >= 3 && bytes[0] == 0xEF && bytes[1] == 0xBB && bytes[2] == 0xBF)
            return System.Text.Encoding.UTF8.GetString(bytes, 3, bytes.Length - 3);
        if (bytes.Length >= 2 && bytes[0] == 0xFF && bytes[1] == 0xFE)
            return System.Text.Encoding.Unicode.GetString(bytes, 2, bytes.Length - 2);
        try
        {
            // UTF-8 strict : lève une exception si le fichier est en Latin1/Windows-1252.
            return new System.Text.UTF8Encoding(false, true).GetString(bytes);
        }
        catch (System.Text.DecoderFallbackException)
        {
            return System.Text.Encoding.Latin1.GetString(bytes);
        }
    }

    /// <summary>Tronque sans couper un surrogate (emoji) au milieu.</summary>
    private static string TruncateSafe(string text, int maxLength)
    {
        if (text.Length <= maxLength) return text;
        var cut = maxLength;
        while (cut > 0 && char.IsLowSurrogate(text[cut])) cut--;
        if (cut <= 0) cut = maxLength;
        return text[..cut] + "…";
    }

    private async Task ShareDocs(IEnumerable<DocumentItem> docs)
    {
        var files = new List<DocImport>();
        foreach (var doc in docs)
        {
            var bytes = DocBytes(doc);
            if (bytes == null) continue;
            files.Add(new DocImport(doc.FileName, doc.Mime, doc.Taille, bytes));
        }
        if (files.Count == 0) { State.NotifyError("Aucun fichier à partager."); return; }
        var ok = await Docs.ShareAsync(files, files.Count == 1 ? files[0].FileName : files.Count + " documents", Saver);
        if (ok)
        {
            Store.LogActivity(ActivityTypes.DocumentShare, "Partage de " + files.Count + " document(s)");
            State.NotifySuccess("Partage ouvert.");
        }
        else State.NotifyError(Docs.LastError ?? "Le partage a échoué.");
        _selected.Clear();
        _selectionMode = false;
    }

