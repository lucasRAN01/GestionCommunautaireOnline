@implements IDisposable
@inject DataStore Store
@inject AppState State

@if (!Store.Can(Permissions.SituationsManage))
{
    <EmptyState Icon="🔒" Title="@L.T("Accès réservé")" Message="@L.T("Le suivi des situations n'est pas autorisé pour votre rôle.")" />
}
else
{
    <div class="page-head">
        <p>@L.T("Membres à visiter, accompagnements, événements importants : ouvrez un suivi, faites-le avancer, clôturez-le.")</p>
    </div>

    <div class="search-box cal-search">
        <span class="search-icon" aria-hidden="true">&#128269;</span>
        <input type="search" placeholder="@L.T("Rechercher un suivi (titre, description, membre, type)…")" aria-label="@L.T("Rechercher un suivi")"
               value="@_search" @oninput="OnSearch" />
    </div>
    @if (!string.IsNullOrWhiteSpace(_search))
    {
        <div class="search-summary">@L.F("{0} suivi(s) trouvé(s) pour « {1} »", Filtered.Count, _search.Trim())</div>
    }

    <div class="chips-row" role="tablist" aria-label="@L.T("Filtrer les suivis")">
        @foreach (var (key, label) in StatutChoices)
        {
            <button type="button" class="chip @(_statut == key ? "active" : "")" @onclick="() => _statut = key">@label</button>
        }
    </div>

    <div class="inline-actions" style="justify-content:flex-end;margin-bottom:10px">
        <button class="btn btn-secondary btn-sm" @onclick="StartAdd">＋ @L.T("Suivi")</button>
    </div>

    @if (Filtered.Count == 0)
    {
        <EmptyState Icon="🤝" Title="@L.T("Aucun suivi")" Message="@L.T("Ouvrez le premier suivi avec le bouton ci-dessus.")" />
    }
    else
    {
        <div class="user-list">
            @foreach (var s in Filtered)
            {
                var sit = s;
                <div class="user-card @(_selectedId == sit.Id ? "selected" : "")" role="button" tabindex="0" @onclick="() => SelectSituation(sit.Id)" @onkeydown="(k) => OnSelectKey(k, sit.Id)">
                    <span class="field-type-icon" aria-hidden="true">@SituationTypes.Icon(sit.Type)</span>
                    <div class="user-card-main">
                        <div class="user-card-name">@sit.Titre</div>
                        <div class="user-card-sub">👤 @MemberName(sit.MembreIdentifiant) · @SituationTypes.Label(sit.Type)</div>
                        <div class="user-card-meta">
                            <Badge Text="@(SituationStatuts.Icon(sit.Statut) + " " + SituationStatuts.Label(sit.Statut))" Kind="@(sit.Statut == SituationStatuts.Resolu ? "active" : "role")" />
                            @if (sit.Priorite != CalendarEventTypes.PrioriteNormale)
                            {
                                <Badge Text="@PriorityLabel(sit.Priorite)" Kind="recent" />
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(sit.Description))
                        {
                            <div class="user-card-sub">@sit.Description</div>
                        }
                    </div>
                    <div class="user-card-actions" @onclick:stopPropagation="true">
                        @if (sit.Statut != SituationStatuts.Resolu)
                        {
                            <button class="btn-icon" aria-label="@L.T("Avancer")" title="@L.T("Avancer")" @onclick="() => Advance(sit)">▶</button>
                        }
                        <button class="btn-icon" aria-label="@L.T("Modifier")" @onclick="() => StartEdit(sit)">✎</button>
                        <button class="btn-icon danger" aria-label="@L.T("Supprimer")" @onclick="() => AskDelete(sit)">🗑</button>
                    </div>
                </div>
            }
        </div>
    }

    @if (SelectedSituation != null)
    {
        var sit = SelectedSituation;
        <div class="card" style="margin-top:12px">
            <div class="inline-actions" style="justify-content:space-between">
                <h3 style="margin:0">@sit.Titre</h3>
                <button class="btn btn-secondary btn-sm" @onclick="() => _selectedId = null">@L.T("Réduire")</button>
            </div>
            @if (!string.IsNullOrWhiteSpace(sit.Description))
            {
                <div class="cal-detail-notes">@sit.Description</div>
            }
            <div class="storage-line"><span>@L.T("Membre")</span><strong>@MemberName(sit.MembreIdentifiant)</strong></div>
            <div class="storage-line"><span>@L.T("Type")</span><strong>@SituationTypes.Label(sit.Type)</strong></div>
            <div class="storage-line"><span>@L.T("Statut")</span><strong>@SituationStatuts.Label(sit.Statut)</strong></div>
            <div class="storage-line"><span>@L.T("Priorité")</span><strong>@PriorityLabel(sit.Priorite)</strong></div>
            <div class="storage-line"><span>@L.T("Ouverte le")</span><strong>@DataStore.FormatDateCourte(sit.DateCreation)</strong></div>
            @if (!string.IsNullOrWhiteSpace(sit.DateResolution))
            {
                <div class="storage-line"><span>@L.T("Résolue le")</span><strong>@DataStore.FormatDateCourte(sit.DateResolution)</strong></div>
            }
        </div>
    }

    <button class="fab" aria-label="@L.T("Nouveau suivi")" @onclick="StartAdd">+</button>

    <Modal Title="@(_editId == null ? L.T("Nouveau suivi") : L.T("Modifier le suivi"))" Show="_showEditor" OnClose="CloseEditor">
        <ChildContent>
            <div class="form-group">
                <label>@L.T("Membre concerné *")</label>
                <MemberPicker Value="@_membre" ValueChanged="@((string v) => _membre = v)" Placeholder="@L.T("Écrire pour chercher un membre…")" />
            </div>
            <div class="form-group">
                <label for="si-type">@L.T("Type")</label>
                <select id="si-type" value="@_type" @onchange="e => _type = e.Value?.ToString() ?? SituationTypes.Visite">
                    <option value="@SituationTypes.Visite">🏠 @L.T("Visite nécessaire")</option>
                    <option value="@SituationTypes.Accompagnement">🤝 @L.T("Accompagnement")</option>
                    <option value="@SituationTypes.EvenementImportant">⭐ @L.T("Événement important")</option>
                    <option value="@SituationTypes.Autre">📌 @L.T("Autre")</option>
                </select>
            </div>
            <div class="form-group">
                <label for="si-titre">@L.T("Titre *")</label>
                <input id="si-titre" type="text" value="@_titre" @oninput="e => _titre = e.Value?.ToString() ?? string.Empty" />
            </div>
            <div class="form-group">
                <label for="si-desc">@L.T("Description")</label>
                <textarea id="si-desc" rows="3" value="@_desc" @oninput="e => _desc = e.Value?.ToString() ?? string.Empty"></textarea>
            </div>
            <div class="form-group">
                <label for="si-prio">@L.T("Priorité")</label>
                <select id="si-prio" value="@_priorite" @onchange="e => _priorite = e.Value?.ToString() ?? CalendarEventTypes.PrioriteNormale">
                    <option value="@CalendarEventTypes.PrioriteNormale">@L.T("Normale")</option>
                    <option value="@CalendarEventTypes.PrioriteImportante">@L.T("Importante")</option>
                    <option value="@CalendarEventTypes.PrioriteUrgente">@L.T("Urgente")</option>
                </select>
            </div>
            <span class="form-error">@_error</span>
        </ChildContent>
        <FooterContent>
            <button class="btn btn-secondary" @onclick="CloseEditor">@L.T("Annuler")</button>
            <button class="btn btn-primary" @onclick="Save">@L.T("Enregistrer")</button>
        </FooterContent>
    </Modal>

    <ConfirmDialog Show="_deleteTarget != null" Title="@L.T("Supprimer le suivi")"
                   Message="@(_deleteTarget == null ? "" : L.F("Supprimer « {0} » ?", _deleteTarget.Titre))"
                   ConfirmLabel="@L.T("Supprimer")" Danger="true" OnConfirm="ConfirmDelete" OnCancel="() => _deleteTarget = null" />
}

@code {
    private static readonly (string Key, string Label)[] StatutChoices =
    {
        ("", L.T("Tous")), (SituationStatuts.Ouvert, L.T("Ouverts")),
        (SituationStatuts.EnCours, L.T("En cours")), (SituationStatuts.Resolu, L.T("Résolus"))
    };

    private string _statut = "";
    private string _search = "";
    private bool _showEditor;
    private string? _editId;
    private string _membre = "";
    private string _type = SituationTypes.Visite;
    private string _titre = "";
    private string _desc = "";
    private string _priorite = CalendarEventTypes.PrioriteNormale;
    private string _error = "";
    private Situation? _deleteTarget;
    private string? _selectedId;

    private IReadOnlyList<UserAccount> ActiveUsers =>
        Store.Users.Where(u => u.Actif).OrderBy(u => u.NomComplet).ToList();

    private IReadOnlyList<Situation> Filtered => Store.Situations
        .Where(s => _statut.Length == 0 || s.Statut == _statut)
        .Where(MatchSearch)
        .OrderBy(s => s.Statut == SituationStatuts.Resolu ? 1 : 0)
        .ThenByDescending(s => s.DateCreation)
        .ToList();

    private bool MatchSearch(Situation s)
    {
        var q = _search.Trim();
        if (q.Length == 0) return true;
        return (s.Titre + " " + s.Description + " " + SituationTypes.Label(s.Type)
            + " " + MemberName(s.MembreIdentifiant))
            .Contains(q, StringComparison.OrdinalIgnoreCase);
    }

    private void OnSearch(ChangeEventArgs e) => _search = e.Value?.ToString() ?? string.Empty;

    private Situation? SelectedSituation => string.IsNullOrWhiteSpace(_selectedId) ? null : Store.Situations.FirstOrDefault(s => s.Id == _selectedId);

    private void SelectSituation(string id) => _selectedId = _selectedId == id ? null : id;

    private void OnSelectKey(KeyboardEventArgs e, string id)
    {
        if (e.Key is "Enter" or " ") SelectSituation(id);
    }

    protected override void OnInitialized()
    {
        Store.DataChanged += Refresh;
    }

    private void Refresh() => _ = InvokeAsync(StateHasChanged);

    private string MemberName(string identifiant)
        => Store.FindUserByIdentifier(identifiant)?.NomComplet ?? identifiant;

    private static string PriorityLabel(string p) => p switch
    {
        CalendarEventTypes.PrioriteUrgente => L.T("Urgente"),
        CalendarEventTypes.PrioriteImportante => L.T("Importante"),
        _ => L.T("Normale")
    };

    private void StartAdd()
    {
        _editId = null;
        _membre = ""; _type = SituationTypes.Visite;
        _titre = ""; _desc = "";
        _priorite = CalendarEventTypes.PrioriteNormale;
        _error = "";
        _showEditor = true;
    }

    private void StartEdit(Situation s)
    {
        _editId = s.Id;
        _membre = s.MembreIdentifiant; _type = s.Type;
        _titre = s.Titre; _desc = s.Description;
        _priorite = s.Priorite;
        _error = "";
        _showEditor = true;
    }

    private void CloseEditor() => _showEditor = false;

    private void Save()
    {
        _error = "";
        OperationResult res = _editId == null
            ? Store.AddSituation(new Situation { MembreIdentifiant = _membre, Type = _type, Titre = _titre, Description = _desc, Priorite = _priorite })
            : Store.UpdateSituation(_editId, new Situation { MembreIdentifiant = _membre, Type = _type, Titre = _titre, Description = _desc, Priorite = _priorite });
        if (!res.Success) { _error = res.Error; return; }
        State.NotifySuccess(_editId == null ? L.T("Suivi ouvert.") : L.T("Suivi enregistré."));
        _showEditor = false;
    }

    private void Advance(Situation s)
    {
        var next = s.Statut == SituationStatuts.Ouvert ? SituationStatuts.EnCours : SituationStatuts.Resolu;
        var res = Store.SetSituationStatut(s.Id, next);
        if (res.Success) State.NotifySuccess(L.F("Suivi → {0}.", SituationStatuts.Label(next)));
        else State.NotifyError(res.Error);
    }

    private void AskDelete(Situation s) => _deleteTarget = s;

    private void ConfirmDelete()
    {
        var t = _deleteTarget;
        _deleteTarget = null;
        if (t == null) return;
        var res = Store.DeleteSituation(t.Id);
        if (res.Success) State.NotifySuccess(L.T("Suivi supprimé."));
        else State.NotifyError(res.Error);
    }

    public void Dispose() => Store.DataChanged -= Refresh;
}
