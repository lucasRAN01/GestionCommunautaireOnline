    private void OpenRestore()
    {
        _restoreError = "";
        _pendingImport = null;
        _showRestore = true;
    }

    private async Task PickRestore()
    {
        _restoreError = "";
        _pendingImport = null;
        var bytes = await Picker.PickXlsxAsync();
        if (bytes == null)
        {
            _restoreError = "Fichier annulé ou illisible.";
            return;
        }

        var result = Store.ParseExcelImport(bytes);
        if (!result.Success)
        {
            _restoreError = "Sauvegarde refusée : " + (result.Error ?? "fichier invalide.");
            return;
        }
        _pendingImport = result.Users;
    }

    private void ApplyRestore()
    {
        _restoreError = "";
        if (_pendingImport == null || _pendingImport.Count == 0)
        {
            _restoreError = "Veuillez d'abord choisir un fichier Excel.";
            return;
        }

        var (res, count) = Store.ApplyImport(_pendingImport!);
        if (!res.Success)
        {
            _restoreError = res.Error;
            return;
        }

        _showRestore = false;
        _pendingImport = null;
        State.NotifySuccess(count + " utilisateur(s) ajouté(s) à l'annuaire.");
    }

    private void DoReset()
    {
        _confirmReset = false;
        Store.ResetAll();
        _ = Js.ApplySettingsAsync(Store.Settings);
        State.NotifySuccess("Les données ont été réinitialisées.");
    }

    private static string ExportFileName(string stem) => stem + "-" + DateTime.Now.ToString("dd-MM-yyyy_HH-mm-ss") + ".xlsx";
