@if (PageCount > 1)
{
    <div class="pager" role="navigation" aria-label="Pagination">
        <button type="button" class="btn btn-secondary btn-sm" disabled="@(Page <= 1)" @onclick="OnPrev">‹ Précédent</button>
        <span class="pager-info">Page @Page / @PageCount · @Total élément(s)</span>
        <button type="button" class="btn btn-secondary btn-sm" disabled="@(Page >= PageCount)" @onclick="OnNext">Suivant ›</button>
    </div>
}

@code {
    [Parameter] public int Page { get; set; } = 1;
    [Parameter] public int PageCount { get; set; } = 1;
    [Parameter] public int Total { get; set; }
    [Parameter] public EventCallback OnPrev { get; set; }
    [Parameter] public EventCallback OnNext { get; set; }
}