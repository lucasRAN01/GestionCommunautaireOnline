@if (PageCount > 1)
{
    <div class="pager" role="navigation" aria-label="@L.T("Pagination")">
        <button type="button" class="btn btn-secondary btn-sm" disabled="@(Page <= 1)" @onclick="OnPrev">@L.T("‹ Précédent")</button>
        <span class="pager-info">@L.F("Page {0} / {1} · {2} élément(s)", Page, PageCount, Total)</span>
        <button type="button" class="btn btn-secondary btn-sm" disabled="@(Page >= PageCount)" @onclick="OnNext">@L.T("Suivant ›")</button>
    </div>
}

@code {
    [Parameter] public int Page { get; set; } = 1;
    [Parameter] public int PageCount { get; set; } = 1;
    [Parameter] public int Total { get; set; }
    [Parameter] public EventCallback OnPrev { get; set; }
    [Parameter] public EventCallback OnNext { get; set; }
}