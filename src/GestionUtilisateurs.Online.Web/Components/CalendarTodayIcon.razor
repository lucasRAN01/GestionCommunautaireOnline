@implements IDisposable
@using System.Globalization
@* Mini-calendrier affichant toujours la date du jour (comme l'icône iOS). *@
<span class="cal-today-ico @(SizeClass)" aria-hidden="true" title="@_full">
    <span class="cal-today-ico-week">@_week</span>
    <span class="cal-today-ico-day">@_day</span>
</span>

@code {
    [Parameter] public string Size { get; set; } = "md";

    private string SizeClass => Size == "sm" ? "cal-today-ico-sm" : Size == "lg" ? "cal-today-ico-lg" : "";
    private string _week = "";
    private string _day = "";
    private string _full = "";
    private System.Threading.Timer? _timer;
    private string _todayKey = "";

    protected override void OnInitialized()
    {
        Refresh();
        // Vérifie chaque minute si le jour a changé (minuit) pour rester sur la date du jour.
        _timer = new System.Threading.Timer(_ =>
        {
            var key = DateTime.Today.ToString("yyyy-MM-dd");
            if (key != _todayKey) _ = InvokeAsync(() => { Refresh(); StateHasChanged(); });
        }, null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
    }

    private void Refresh()
    {
        var today = DateTime.Today;
        _todayKey = today.ToString("yyyy-MM-dd");
        // Malgache : 4 lettres (alah, alat, alar, alak) pour distinguer les jours en « ala- ».
        var abbr = L.Jour(today.DayOfWeek);
        var n = L.Langue == L.Mg ? 4 : 3;
        _week = abbr.Length >= n ? char.ToUpperInvariant(abbr[0]) + abbr[1..n] : abbr;
        _day = today.Day.ToString();
        _full = today.ToString("dd/MM/yyyy");
    }

    public void Dispose() => _timer?.Dispose();
}
